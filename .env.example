# Copy to .env and fill in. Never commit a real .env.

# demo (default) | live
SOLOLEDGER_MODE=demo

# Stripe restricted key for live read-only revenue sync.
# Create at https://dashboard.stripe.com/apikeys with ONLY "Balance Transactions: Read"
# (or "Charges: Read"). Full sk_live_ keys are refused unless you set
# SOLOLEDGER_ALLOW_LIVE_KEY=1 explicitly.
SOLOLEDGER_STRIPE_KEY=
SOLOLEDGER_ALLOW_LIVE_KEY=0

# Weekly digest email (Resend free tier). Leave blank to preview-only.
RESEND_API_KEY=
SOLOLEDGER_DIGEST_TO=
SOLOLEDGER_DIGEST_FROM=SoloLedger <digest@sololedger.app>

# SQLite path (default: ./sololedger.db next to the app)
SOLOLEDGER_DB=
